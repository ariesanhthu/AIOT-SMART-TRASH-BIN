flowchart TB
    start(["UC8: Cấu hình và quản lý thiết bị từ xa"]) --> actor["Actor: Quản lý"]
    actor --> trigger[/"Input / Trigger: Mở trang cấu hình<br>thiết bị trên dashboard"/]
    select["Chọn thiết bị cần cấu hình"] --> action{"Hành động<br>muốn thực hiện?"}
    action -- Ngưỡng đầy --> threshold["Cập nhật ngưỡng đầy<br>cho từng ngăn"]
    threshold --> server[("Server xác thực quyền<br>và lưu lệnh")]
    action -- Model AI --> ota["Tải lên file model AI mới"]
    ota --> server
    action -- Bảo trì --> maintenance["Bật hoặc tắt<br>chế độ bảo trì"]
    maintenance --> server
    server --> online{"Thiết bị đang<br>trực tuyến?"}
    online -- Có --> push["Server đẩy lệnh<br>xuống firmware"]
    push --> firmware["Firmware nhận lệnh,<br>xác nhận và áp dụng"]
    firmware --> dashboard["Dashboard hiển thị<br>trạng thái thực thi thành công"]
    online -- Không --> queue["Lệnh được lưu chờ<br>trên server"]
    queue --> sync["Tự động áp dụng<br>khi thiết bị kết nối lại"]
    sync --> firmware
    dashboard --> output[/"Output: Thiết bị hoạt động<br>theo cấu hình mới"/]
    output --> finish(["Kết thúc UC8"])
    trigger --> select

