flowchart TD
    start([Bắt đầu UC3])
    input[/"Input: Mã loại rác từ UC2<br/>Trạng thái đầy của các ngăn"/]
    controller["Device: Mạch điều khiển<br/>tiếp nhận mã phân loại"]
    map["Đối chiếu mã loại rác<br/>với vị trí ngăn chứa"]
    full{"Ngăn mục tiêu<br/>đã đầy?"}
    cancel["Hủy lệnh mở nắp<br/>để tránh rác tràn"]
    fullOut[/"Output thay thế:<br/>Thông báo ngăn đầy / từ chối nhận rác"/]
    command["Mạch điều khiển phát lệnh<br/>đến servo của ngăn đã chọn"]
    servoOpen["Device: Servo quay<br/>mở đúng nắp ngăn rác"]
    student["Học sinh bỏ rác<br/>vào ngăn đã mở"]
    timer["Chờ khoảng thời gian<br/>an toàn đã cấu hình"]
    servoClose["Device: Servo quay về<br/>vị trí đóng nắp"]
    output[/"Output chính: Rác nằm đúng ngăn<br/>Nắp đã đóng an toàn"/]
    finish([Kết thúc UC3])

    start --> input --> controller --> map --> full
    full -- Có --> cancel --> fullOut --> finish
    full -- Không --> command --> servoOpen --> student --> timer --> servoClose --> output --> finish

    classDef actor fill:#fff3cd,stroke:#b58105,color:#3d2b00;
    classDef device fill:#dbeafe,stroke:#2563eb,color:#102a56;
    classDef input fill:#fef9c3,stroke:#ca8a04,color:#422006;
    classDef process fill:#f3e8ff,stroke:#9333ea,color:#3b0764;
    classDef decision fill:#ffedd5,stroke:#ea580c,color:#431407;
    classDef output fill:#dcfce7,stroke:#16a34a,color:#052e16;
    classDef warning fill:#fee2e2,stroke:#dc2626,color:#450a0a;
    classDef terminal fill:#e5e7eb,stroke:#4b5563,color:#111827;

    class student actor;
    class controller,servoOpen,servoClose device;
    class input input;
    class map,command,timer process;
    class full decision;
    class output,fullOut output;
    class cancel warning;
    class start,finish terminal;
