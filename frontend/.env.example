# Vite development proxy. Use the ESP32 IP printed in Serial Monitor.
# Copy this file to .env.local, then restart npm run dev after changing it.
# Để rỗng khi chạy dev: browser gọi /api qua Vite proxy.
VITE_API_BASE_URL=
BACKEND_URL=http://localhost:8080

ESP32_CAMERA_URL=http://172.20.10.2
ESP32_STREAM_URL=http://172.20.10.2:81

# Firebase Console > Project settings > General > Your apps > Web app (</>).
# Required or the app throws "auth/invalid-api-key" at startup.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional for a production build that connects from the browser directly.
# The ESP32 firmware enables CORS on both endpoints.
# VITE_ESP32_CAMERA_URL=http://192.168.4.123
# VITE_ESP32_STREAM_URL=http://192.168.4.123:81
